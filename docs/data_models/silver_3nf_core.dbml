// Silver Layer: 3NF Integrated Core (FSLDM-inspired Party / Contract / Transaction)
// Target Catalog/Schema: retail_banking_dw.silver

Table silver_customers_scd2 {
  customer_id varchar [pk, note: 'Party Natural Key from Core Banking']
  national_id varchar [not null, note: 'Czech Birth Number (Rodne Cislo) - PII Masked in UC']
  first_name varchar
  last_name varchar
  email varchar [note: 'PII Masked in UC']
  phone_number varchar [note: 'PII Masked in UC']
  branch_region varchar [not null, note: 'PRAGUE, BRNO, OSTRAVA - Used for UC Row Filtering']
  banking_segment varchar [not null, note: 'RETAIL, PREMIUM, PRIVATE']
  credit_score int [note: 'Range 300-850']
  credit_tier varchar [note: 'A, B, C, D - Tracked via SCD2']
  address_city varchar
  customer_status varchar [note: 'ACTIVE, SUSPENDED, CLOSED']
  __START_AT timestamp [pk, note: 'System-generated by Lakeflow AUTO CDC (SCD2)']
  __END_AT timestamp [note: 'System-generated by Lakeflow AUTO CDC (NULL = current)']
  _source_file varchar
  _ingested_at timestamp
}

Table silver_products {
  product_code varchar [pk, note: 'e.g., MORT_FIX_5Y, CONS_UNSEC, AUTO_LOAN_3Y']
  product_name varchar [not null]
  product_domain varchar [not null, note: 'LENDING, DEPOSITS, CARDS (Filtered to LENDING for this mart)']
  product_category varchar [not null, note: 'MORTGAGE, CONSUMER_LOAN, AUTO_LOAN']
  base_interest_rate decimal(5,4)
  max_term_months int
  collateral_required boolean
  updated_at timestamp
}

Table silver_contracts {
  contract_id varchar [pk, note: 'Generalized Agreement/Contract NK (e.g., CNTR-5001)']
  customer_id varchar [not null, ref: > silver_customers_scd2.customer_id]
  product_code varchar [not null, ref: > silver_products.product_code]
  origination_date date [not null]
  maturity_date date [not null]
  principal_amount decimal(18,2) [not null, note: 'Expectation: > 0']
  interest_rate decimal(5,4) [not null, note: 'Contractual annual rate']
  installment_amount decimal(18,2) [not null]
  currency_code varchar(3) [default: 'CZK']
  contract_status varchar [not null, note: 'ACTIVE, PAID_OFF, DEFAULTED, DELINQUENT']
  updated_at timestamp
  _source_file varchar
}

Table silver_financial_transactions {
  transaction_id varchar [pk, note: 'Deduplicated Ledger Transaction NK (e.g., TXN-9001)']
  contract_id varchar [not null, ref: > silver_contracts.contract_id]
  transaction_type_code varchar [not null, note: 'DISBURSEMENT, SCHEDULED_REPAYMENT, EARLY_REPAYMENT, FEE_CHARGE']
  transaction_date date [not null]
  transaction_timestamp timestamp [not null]
  total_transaction_amount decimal(18,2) [not null, note: 'Expectation: > 0']
  principal_amount decimal(18,2) [not null]
  interest_amount decimal(18,2) [not null]
  fee_amount decimal(18,2) [default: 0.00]
  payment_channel varchar [note: 'DIRECT_DEBIT, MOBILE_APP, WIRE, BRANCH']
  days_past_due int [default: 0, note: 'DPD of contract at time of transaction']
  _source_file varchar
}

Table silver_quarantine_records {
  quarantine_id bigint [pk, increment]
  source_entity varchar [not null, note: 'CUSTOMERS, CONTRACTS, TRANSACTIONS']
  failed_rule varchar [not null, note: 'e.g., valid_principal_amount, non_null_contract_id']
  raw_payload varchar [not null, note: 'JSON serialized record or _rescued_data']
  source_file varchar
  quarantined_at timestamp [not null]
}